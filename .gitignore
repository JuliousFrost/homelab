# ignore editor/backup files
*.bak*
*~
.#*

# music-stack app data (do not track)
vm/music-stack/lidarr/
vm/music-stack/navidrome/

# toolkit app data (do not track)
vm/toolkit/syncthing/config/
vm/toolkit/homarr/appdata/
vm/toolkit/beets/config/

# jellyfin stack app data (do not track)
vm/jellyfin/config/
vm/jellyfin/jellyseerr/**/config/
vm/jellyfin/jellystat/**/config/
**/.env
*.bak*

# media-stack app data (do not track)
vm/media-stack/**/config/
vm/media-stack/**/data/
vm/media-stack/**/downloads/
vm/media-stack/**/logs/
**/.env
*.bak*
